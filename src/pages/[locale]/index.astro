---
import BaseLayout from '../../layouts/BaseLayout.astro';
import contentData from '../../data/published-content.json';
import reviewData from '../../data/review-preview-content.json';
import { getPublishedContent } from '../../lib/published-content.js';

export function getStaticPaths() {
  return ['en', 'hi'].map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale === 'hi' ? 'hi' : 'en';
const isHindi = locale === 'hi';
const publishedItems = getPublishedContent(contentData, locale).map((item: any) => ({ ...item, isReviewDraft: false }));
const reviewItems = (reviewData.items || []).map((item: any) => ({ ...item, isReviewDraft: true }));
const items = [...reviewItems, ...publishedItems];
const pageTitle = isHindi ? 'ज्ञान संग्रह' : 'Knowledge library';
const description = isHindi
  ? 'शिव-केंद्रित अध्ययन संग्रह, स्रोत-संदर्भ और हिंदी-अंग्रेज़ी पठन अनुभव।'
  : 'Explore the Shiva learning collection with source references and bilingual reading.';
const categories = isHindi ? [
  { symbol: 'ॐ', title: 'देवता और स्वरूप', detail: 'शिव के चुने हुए रूप और संदर्भ', href: import.meta.env.BASE_URL + 'hi/selected-shiva-forms/' },
  { symbol: 'ग्र', title: 'शास्त्र और ग्रंथ', detail: 'पाठ, संस्करण और स्रोत', href: import.meta.env.BASE_URL + 'hi/shiva-scripture-guide/' },
  { symbol: '◉', title: 'दर्शन और परंपराएँ', detail: 'शैव परंपराओं की विविधता', href: import.meta.env.BASE_URL + 'hi/shaiva-traditions-introduction/' },
  { symbol: 'शक्ति', title: 'शिव और शक्ति', detail: 'विविध धार्मिक दृष्टिकोण', href: import.meta.env.BASE_URL + 'hi/shiva-shakti-relationship/' },
  { symbol: 'दीप', title: 'अध्ययन-मार्ग', detail: 'शुरुआत से स्रोत-सचेत पठन तक', href: import.meta.env.BASE_URL + 'hi/beginner-shiva-learning-path/' }
] : [
  { symbol: 'ॐ', title: 'Deities & forms', detail: 'Selected forms and their contexts', href: import.meta.env.BASE_URL + 'en/selected-shiva-forms/' },
  { symbol: 'ग्र', title: 'Scriptures & texts', detail: 'Texts, editions, and references', href: import.meta.env.BASE_URL + 'en/shiva-scripture-guide/' },
  { symbol: '◉', title: 'Philosophy & traditions', detail: 'The diversity of Shaiva traditions', href: import.meta.env.BASE_URL + 'en/shaiva-traditions-introduction/' },
  { symbol: 'शक्ति', title: 'Shiva & Shakti', detail: 'Different theological perspectives', href: import.meta.env.BASE_URL + 'en/shiva-shakti-relationship/' },
  { symbol: 'दीप', title: 'Guided learning', detail: 'From foundations to source-aware reading', href: import.meta.env.BASE_URL + 'en/beginner-shiva-learning-path/' }
];
---
<BaseLayout title={`${pageTitle} — Sanātana Dharma`} description={description} lang={locale}>
  <main id="main" class="library-page library-page-redesign">
    <div class="review-banner" role="note">
      <span class="review-banner-mark" aria-hidden="true">✦</span>
      <div><strong>{isHindi ? 'समीक्षा पूर्वावलोकन' : 'Review preview'}</strong><p>{isHindi ? 'शिव-संग्रह के प्रारूप समीक्षा के लिए उपलब्ध हैं। ये लेख अभी प्रकाशन के लिए स्वीकृत नहीं हैं; प्रत्येक स्रोत की स्थिति नीचे दी गई है।' : 'Shiva collection drafts are available for review. These articles are not yet approved for publication; source status is shown within each article.'}</p></div>
    </div>
    <section class="library-hero library-hero-redesign" aria-labelledby="library-title">
      <p class="eyebrow">{isHindi ? 'ज्ञान · संदर्भ · भक्ति' : 'Knowledge · Context · Devotion'}</p>
      <h1 id="library-title">{isHindi ? 'परंपरा को समझें। संदर्भ के साथ।' : 'Explore the tradition. With context.'}</h1>
      <p class="library-intro">{isHindi
        ? 'शिव से आरंभ करते हुए, ग्रंथों, कला, दर्शन और जीवित परंपराओं को सावधानी से समझने का संग्रह।'
        : 'A growing library that begins with Shiva and explores texts, art, philosophy, and living traditions with care.'}</p>
      <div class="library-search-wrap">
        <label for="library-search">{isHindi ? 'विषय खोजें' : 'Search the library'}</label>
        <input id="library-search" class="library-search" type="search" placeholder={isHindi ? 'जैसे शिव, रुद्र, प्रतीक…' : 'Try Shiva, Rudra, symbols…'} autocomplete="off" />
        <p id="search-count" class="search-count" aria-live="polite">{isHindi ? `${items.length} लेख उपलब्ध` : `${items.length} articles available`}</p>
      </div>
    </section>

    <section class="category-section" aria-labelledby="category-title">
      <div class="section-heading"><div><p class="eyebrow">{isHindi ? 'ज्ञान मानचित्र' : 'Knowledge map'}</p><h2 id="category-title">{isHindi ? 'अपनी रुचि से शुरुआत करें' : 'Find your path in'}</h2></div><p class="section-intro">{isHindi ? 'संग्रह का विस्तार क्रमशः होगा; अभी शिव-विषयक प्रारूप समीक्षा के लिए उपलब्ध हैं।' : 'The library will grow in focused collections. Shiva drafts are available now for owner review.'}</p></div>
      <div class="category-grid">
        {categories.map((category) => <a class="category-card" href={category.href}><span class="category-symbol" aria-hidden="true">{category.symbol}</span><span><strong>{category.title}</strong><small>{category.detail}</small></span><span class="category-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </section>

    <section id="featured" class="featured-section" aria-labelledby="featured-title">
      <div class="section-heading"><div><p class="eyebrow">{isHindi ? 'शिव ज्ञान-संग्रह' : 'The Shiva collection'}</p><h2 id="featured-title">{isHindi ? 'पढ़ना शुरू करें' : 'Start exploring'}</h2></div><p class="section-intro">{isHindi ? 'हर लेख में विषय-संदर्भ, स्रोत-स्थिति और आगे पढ़ने के रास्ते दिए गए हैं।' : 'Each article includes context, source-status notes, and paths to related reading.'}</p></div>
      <div class="library-grid library-grid-featured" id="article-list">
        {items.map((item: any) => {
          const localized = item.locales[locale];
          return <article class="library-card feature-article-card" data-search={`${localized.title} ${localized.summary} ${item.id}`.toLowerCase()}>
            <div class="article-card-top"><span class="card-type">{item.type.replaceAll('-', ' ')}</span><span class={item.isReviewDraft ? 'status-badge status-badge-review' : 'status-badge status-badge-complete'}>{item.isReviewDraft ? (isHindi ? 'समीक्षा प्रारूप' : 'Review draft') : (isHindi ? 'प्रकाशित' : 'Published')}</span></div>
            <h3><a href={import.meta.env.BASE_URL + locale + '/' + item.slug + '/'}>{localized.title}</a></h3>
            <p>{localized.summary}</p>
            <div class="article-card-footer"><span>{isHindi ? `${item.sourceReferences?.length || 0} स्रोत-संदर्भ` : `${item.sourceReferences?.length || 0} source references`}</span><a href={import.meta.env.BASE_URL + locale + '/' + item.slug + '/'}>{isHindi ? 'लेख पढ़ें' : 'Read article'} <span aria-hidden="true">→</span></a></div>
          </article>;
        })}
      </div>
      <div id="no-results" class="empty-state" hidden><h3>{isHindi ? 'कोई मेल नहीं मिला' : 'No matching topics'}</h3><p>{isHindi ? 'दूसरा शब्द आज़माएँ या खोज साफ़ करें।' : 'Try another term or clear your search.'}</p></div>
    </section>

    <section id="principles" class="principles-section library-principles" aria-labelledby="principles-title">
      <div class="section-heading"><div><p class="eyebrow">{isHindi ? 'संपादकीय दृष्टि' : 'Editorial approach'}</p><h2 id="principles-title">{isHindi ? 'श्रद्धा के साथ, प्रमाण के प्रति ईमानदारी' : 'Reverence, with honesty about evidence'}</h2></div></div>
      <div class="principle-grid">
        <article><span class="principle-number">01</span><h3>{isHindi ? 'स्रोत स्पष्ट' : 'Visible sources'}</h3><p>{isHindi ? 'स्रोत का नाम, संदर्भ और सत्यापन की स्थिति स्पष्ट रूप से दिखाई जाती है।' : 'Source names, locators, and verification status are shown rather than implied.'}</p></article>
        <article><span class="principle-number">02</span><h3>{isHindi ? 'दोनों भाषाएँ' : 'Both languages matter'}</h3><p>{isHindi ? 'हिंदी और अंग्रेज़ी को स्वतंत्र समीक्षा की आवश्यकता है।' : 'Hindi and English need their own meaning and parity checks.'}</p></article>
        <article><span class="principle-number">03</span><h3>{isHindi ? 'परंपराओं का सम्मान' : 'Respect for diversity'}</h3><p>{isHindi ? 'विशिष्ट परंपराओं की व्याख्या को सार्वभौमिक तथ्य की तरह प्रस्तुत नहीं किया जाता।' : 'Tradition-specific interpretations are not presented as universal claims.'}</p></article>
        <article><span class="principle-number">04</span><h3>{isHindi ? 'समीक्षा से पहले प्रकाशन नहीं' : 'Review before publication'}</h3><p>{isHindi ? 'समीक्षा प्रारूप और स्वीकृत सामग्री के बीच स्पष्ट अंतर रखा जाता है।' : 'Review drafts remain distinct from formally approved release content.'}</p></article>
      </div>
    </section>
  </main>
  <script is:inline>
    (() => {
      const input = document.getElementById('library-search');
      const cards = Array.from(document.querySelectorAll('[data-search]'));
      const noResults = document.getElementById('no-results');
      const count = document.getElementById('search-count');
      if (!input) return;
      input.addEventListener('input', () => {
        const query = input.value.trim().toLocaleLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const match = !query || card.dataset.search.includes(query);
          card.hidden = !match;
          if (match) visible += 1;
        });
        if (noResults) noResults.hidden = visible > 0;
        if (count) count.textContent = visible + (document.documentElement.lang === 'hi' ? ' लेख उपलब्ध' : ' articles found');
      });
    })();
  </script>
</BaseLayout>
