---
import BaseLayout from '../layouts/BaseLayout.astro';
import reviewData from '../data/review-preview-content.json';
const featured = reviewData.items || [];
---
<BaseLayout
  title="Sanātana Dharma — Knowledge, context, and devotion"
  description="Explore Sanātana Dharma through a growing bilingual library, thoughtful context, and visible source references."
>
  <main id="main" class="home-page home-page-redesign">
    <div class="review-banner home-review-banner" role="note">
      <span class="review-banner-mark" aria-hidden="true">✦</span>
      <div><strong>Owner review preview</strong><p>The first Shiva collection is available to explore. Articles are drafts for review, not yet approved for publication; source status is shown on each article.</p></div>
      <a href={import.meta.env.BASE_URL + 'en/'}>Explore library <span aria-hidden="true">→</span></a>
    </div>

    <section class="hero hero-redesign" aria-labelledby="hero-title">
      <div class="hero-copy-block">
        <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true">✦</span> ज्ञान · संदर्भ · भक्ति · Knowledge · Context · Devotion</p>
        <h1 id="hero-title">A living tradition.<br /><span>Explore it thoughtfully.</span></h1>
        <p class="hero-copy">Discover the ideas, texts, symbols, sacred places, and devotional traditions of Sanātana Dharma—with room for diverse perspectives and honesty about what the sources can tell us.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={import.meta.env.BASE_URL + 'en/'}>Explore the knowledge library <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href={import.meta.env.BASE_URL + 'hi/'} lang="hi">हिन्दी में पढ़ें</a>
        </div>
        <div class="hero-trust-row"><span><span class="trust-check" aria-hidden="true">✓</span> Hindi + English</span><span><span class="trust-check" aria-hidden="true">✓</span> Visible sources</span><span><span class="trust-check" aria-hidden="true">✓</span> Tradition-aware context</span></div>
      </div>
      <aside class="hero-art-panel" aria-label="Shiva learning collection">
        <img class="hero-art-image" src="https://collectionapi.metmuseum.org/api/collection/v1/iiif/39328/154124/main-image" alt="Bronze sculpture of Shiva as Nataraja dancing within a ring of flames." loading="lazy" />
        <p class="hero-art-credit">Artwork: The Metropolitan Museum of Art · <a href="https://www.metmuseum.org/art/collection/search/39328" target="_blank" rel="noopener noreferrer">Public-domain collection record</a></p>
        <p class="hero-art-kicker">THE FIRST COLLECTION</p>
        <h2>Begin with Shiva</h2>
        <p>Explore names, forms, symbols, and the many contexts in which Shiva is understood.</p>
        <a href={import.meta.env.BASE_URL + 'en/shiva-overview/'}>Read the introduction <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <section class="home-collection section-block" aria-labelledby="collection-title">
      <div class="section-heading"><div><p class="eyebrow">Curated learning</p><h2 id="collection-title">A library built for meaningful discovery</h2></div><p class="section-intro">Start with an accessible introduction, follow the sources, and continue into related topics at your own pace.</p></div>
      <div class="home-topic-grid">
        <a class="home-topic-card" href={import.meta.env.BASE_URL + 'en/'}><span class="home-topic-symbol" aria-hidden="true">ॐ</span><span><strong>Deities & forms</strong><small>Names, attributes, visual forms, and traditions</small></span><span class="home-topic-arrow" aria-hidden="true">↗</span></a>
        <a class="home-topic-card" href={import.meta.env.BASE_URL + 'en/rudra-shiva-terminology/'}><span class="home-topic-symbol" aria-hidden="true">ग्र</span><span><strong>Texts & terminology</strong><small>Read names and concepts within their textual context</small></span><span class="home-topic-arrow" aria-hidden="true">↗</span></a>
        <a class="home-topic-card" href={import.meta.env.BASE_URL + 'en/shiva-iconography-symbols/'}><span class="home-topic-symbol" aria-hidden="true">◉</span><span><strong>Symbols & sacred art</strong><small>Understand selected images through object-specific sources</small></span><span class="home-topic-arrow" aria-hidden="true">↗</span></a>
        <a class="home-topic-card" href={import.meta.env.BASE_URL + 'hi/'}><span class="home-topic-symbol" aria-hidden="true">अ</span><span><strong>हिन्दी ज्ञान संग्रह</strong><small>Explore the same collection in Hindi</small></span><span class="home-topic-arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="home-featured section-block" aria-labelledby="featured-title">
      <div class="section-heading"><div><p class="eyebrow">The Shiva collection</p><h2 id="featured-title">Three starting points</h2></div><a class="text-link" href={import.meta.env.BASE_URL + 'en/'}>View the library <span aria-hidden="true">→</span></a></div>
      <div class="home-article-grid">
        {featured.map((item: any, index: number) => <article class="home-article-card">
          <div class={`article-card-art article-art-${index + 1}`} aria-hidden="true"><span>{index === 0 ? 'ॐ' : index === 1 ? 'रु' : 'नृ'}</span><i></i></div>
          <div class="home-article-copy"><div class="article-card-top"><span class="card-type">{item.type.replaceAll('-', ' ')}</span><span class="status-badge status-badge-review">Review draft</span></div>
            <h3><a href={import.meta.env.BASE_URL + 'en/' + item.slug + '/'}>{item.locales.en.title}</a></h3>
            <p>{item.locales.en.summary}</p>
            <div class="article-card-footer"><span>{item.sourceReferences.length} source references</span><a href={import.meta.env.BASE_URL + 'en/' + item.slug + '/'}>Read article <span aria-hidden="true">→</span></a></div>
          </div>
        </article>)}
      </div>
    </section>

    <section class="home-editorial section-block" aria-labelledby="editorial-title">
      <div class="editorial-intro"><p class="eyebrow">Our editorial promise</p><h2 id="editorial-title">Respect the tradition.<br /><span>Be honest about evidence.</span></h2><p>Sanātana Dharma contains many texts, schools, communities, and ways of understanding the sacred. A good learning resource should honour that breadth rather than flatten it into one simple story.</p><a class="text-link" href={import.meta.env.BASE_URL + 'en/#editorial-title'}>How we approach sources <span aria-hidden="true">→</span></a></div>
      <div class="editorial-principles">
        <article><span class="principle-number">01</span><div><h3>Sources are visible</h3><p>Each reference shows what it can support—and where verification remains open.</p></div></article>
        <article><span class="principle-number">02</span><div><h3>Traditions keep their context</h3><p>Specific interpretations are attributed instead of presented as universal.</p></div></article>
        <article><span class="principle-number">03</span><div><h3>Hindi and English both matter</h3><p>Meaning and parity need attention in both languages, not just literal translation.</p></div></article>
        <article><span class="principle-number">04</span><div><h3>Review status stays clear</h3><p>Drafts, verified claims, and approved releases are kept distinct.</p></div></article>
      </div>
    </section>

    <section class="closing-band closing-band-redesign" aria-labelledby="closing-title">
      <div><p class="eyebrow">Your learning journey starts here</p><h2 id="closing-title">Explore with curiosity.<br />Read with context.</h2><p>Begin with the Shiva collection in English or Hindi.</p></div>
      <div class="closing-actions"><a class="button button-light" href={import.meta.env.BASE_URL + 'en/'}>Explore in English <span aria-hidden="true">→</span></a><a class="button button-outline-light" href={import.meta.env.BASE_URL + 'hi/'} lang="hi">हिन्दी में पढ़ें</a></div>
    </section>
  </main>
</BaseLayout>
